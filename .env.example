# FitMeet Platform Configuration
APP_URL="https://fitmeet.in"
CLIENT_DOMAIN="fitmeet.in"
PORT=3000

# Supabase Auth & PostgreSQL Database
# Retrieve from Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Razorpay Payment Gateway (TEST MODE FIRST)
# Retrieve from Razorpay Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# GEMINI_API_KEY (if enabled for intelligent recommendations)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
